# =====================================================================
# Prompt Techies / Promptothon — UNIFIED env template (single monorepo)
# =====================================================================
# This is the ONLY .env example in the repo. VPS / Docker deploy needs
# ONE copy (run from repo root):
#
#   cp .env.example .env   # then fill real secrets below
#   docker compose up --build -d
#
#   Tests     (optional):             cp .env.example backend/.env.test
#             then point DATABASE_URL/DIRECT_URL at promptothon_test,
#             set NODE_ENV=test and PORT=4001 (see Section 4).
#
# Runtime files (single-file deploy):
#   .env               everything — Next.js + API + Postgres [gitignored]
#   backend/.env       OPTIONAL legacy override for the API only
#                      (if present, wins over `.env` for `api`; safe to
#                      delete — `server.js`/`seed.js` fall back to `../.env`)
#   backend/.env.test  test isolation (keeps jest off dev)   [gitignored]
# Deleted: .env.local (merged into .env), backend/.env.example (this file
# replaces it), backend/.gitignore (merged into root .gitignore).
#
# PROD checklist: fresh JWT_SECRET + JURY_ALIAS_SALT, fresh POSTGRES_PASSWORD
# + ADMIN_PASSWORD, NODE_ENV=production, SITE_URL/CLIENT_ORIGIN = real domains.
# =====================================================================

# ---------------------------------------------------------------------
# Section 1 — FRONTEND (Next.js, reads root `.env`)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Chatbot (src/components/chatbot.js) — Groq API key, REQUIRED for Ask PT
NEXT_PUBLIC_GROQ_API_KEY=

# Optional Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Social Media & Community Links
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/cbitosc/
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/cbitosc/
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/cbitosc/
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/cbitosc/
NEXT_PUBLIC_HACKATHON_LINKEDIN_URL=https://linkedin.com/company/cbit-hackathon
NEXT_PUBLIC_GITHUB_URL=https://github.com/cbitosc
NEXT_PUBLIC_SUBSTACK_URL=https://cbitosc.substack.com/
NEXT_PUBLIC_COMMUNITY_URL=https://cbitosc.github.io/
NEXT_PUBLIC_CODE_OF_CONDUCT_URL=https://cbitosc.github.io/coc/

# Hackathon & Sponsor Links
NEXT_PUBLIC_HACKTOBERFEST_URL=https://hacktoberfest.com
NEXT_PUBLIC_SPONSOR_TITLE_URL=https://google.com
NEXT_PUBLIC_SPONSOR_CO_URL=https://google.com

# Contact Details
NEXT_PUBLIC_CONTACT_EMAIL=cosc@cbit.ac.in
NEXT_PUBLIC_CONTACT_PHONE_MEGHANA=+916281657674
NEXT_PUBLIC_CONTACT_PHONE_SRILEKHA=+917416939873

# ---------------------------------------------------------------------
# Section 2 — BACKEND (Express API, reads root `.env`;
# `backend/.env` optional legacy override)
# ---------------------------------------------------------------------
# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Database (local Postgres via docker compose, matches Section 3).
DATABASE_URL="postgresql://postgres:password123@localhost:5432/promptothon"
DIRECT_URL="postgresql://postgres:password123@localhost:5432/promptothon"

# Redis — NOT currently required. Only needed if you horizontally scale
# the backend (Redis rate-limit store / Socket.IO adapter).
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="promptothon_token"

# Jury identity masking (HMAC salt so Jury #N aliases can't be reverse engineered)
JURY_ALIAS_SALT="change-this-too"

# Admin bootstrap (used only by prisma/seed.js)
ADMIN_EMAIL="admin@promptothon.dev"
ADMIN_PASSWORD="ChangeMe123!"

# Shared password for the other seed accounts (jury/participants/leaders).
# If unset, prisma/seed.js generates a random one and prints it once.
SEED_PASSWORD=""

# Pitch-deck uploads: "local" (default — PDFs are stored on this server's
# own disk under LOCAL_STORAGE_DIR and streamed back by the API; on the
# VPS that directory is a persistent Docker volume, so files survive
# container rebuilds/restarts) | "disabled" (upload endpoints return 501).
STORAGE_PROVIDER="local"
# Directory where pitch decks are stored. In docker-compose.yml the api
# service sets this to /data/pitch-decks (named volume). For local
# `node src/server.js` dev, leave it unset to use
# backend/storage/pitch-decks/ (auto-created, gitignored).
# LOCAL_STORAGE_DIR="/data/pitch-decks"
# Public base URL of the API, used to build the browser-facing upload and
# download links handed to the frontend. MUST be reachable from user
# browsers (not just inside the compose network). docker-compose.yml also
# reads this from the ROOT .env for interpolation, so keep it there too.
API_PUBLIC_URL="http://localhost:4000"

# "enabled" makes POST /api/team/submission best-effort verify the GitHub
# repo exists via the public GitHub API. Leave "disabled" for local dev.
GITHUB_API_VERIFICATION="disabled"

# ---------------------------------------------------------------------
# Section 3 — DOCKER Postgres (used by root docker-compose.yml `db`)
# ---------------------------------------------------------------------
# Must match the password/db in Section 2 DATABASE_URL when running locally.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=promptothon

# ---------------------------------------------------------------------
# Section 4 — TESTS (lives in `backend/.env.test`, optional file)
# ---------------------------------------------------------------------
# Copy Section 2, then override ONLY these (keeps jest off your dev DB):
# NODE_ENV=test
# PORT=4001
# DATABASE_URL="postgresql://postgres:password123@localhost:5432/promptothon_test"
# DIRECT_URL="postgresql://postgres:password123@localhost:5432/promptothon_test"
# (backend/tests/env.js already falls back to safe mock defaults, so this
# file is only needed for integration tests against real Postgres.)
