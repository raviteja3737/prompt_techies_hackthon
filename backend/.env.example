# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL, via Prisma)
# ---------------------------------------------------------------------------
# DATABASE_URL: the POOLED connection (pgbouncer, port 6543) — used at
#   runtime by every query the app makes.
# DIRECT_URL:   the UNPOOLED connection (port 5432) — Prisma needs this for
#   `migrate`/`db push`, since pgbouncer's transaction pooling mode doesn't
#   support the prepared statements / advisory locks migrations rely on.
# Get both from: Supabase Dashboard -> Project Settings -> Database ->
# Connection string (toggle "Use connection pooling" off/on for each).
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase project credentials
# ---------------------------------------------------------------------------
# From: Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
# SERVER-SIDE ONLY. Full bucket/table access — never send this to the
# frontend, never return it in an API response, never log it. Used only by
# src/services/storage/supabaseStorage.js.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Redis — NOT currently required. Only needed if you horizontally scale
# the backend and add a Redis-backed rate-limit store / Socket.IO adapter
# yourself (see comments in src/middleware/rateLimiter.js and
# src/sockets/index.js). Safe to leave unset for local/single-instance dev.
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="promptothon_token"

# Jury identity masking (HMAC salt so Jury #N aliases can't be reverse engineered)
JURY_ALIAS_SALT="change-this-too"

# Admin bootstrap (used only by prisma/seed.js)
ADMIN_EMAIL="admin@promptothon.dev"
ADMIN_PASSWORD="ChangeMe123!"

# Shared password for the other seed accounts (jury/participants/leaders).
# If unset, prisma/seed.js generates a random one and prints it once.
SEED_PASSWORD=""

# ---------------------------------------------------------------------------
# Pitch-deck uploads (spec \u00a74/\u00a727)
# ---------------------------------------------------------------------------
# "supabase" (recommended, requires SUPABASE_* above) | "s3" (legacy/optional)
# | "disabled" (default — upload endpoints return a clear 501 instead of
# crashing on boot when no provider is configured).
STORAGE_PROVIDER="supabase"
# Must be created as a PRIVATE bucket in Supabase Storage. See README
# "Supabase Storage bucket setup" for the exact steps.
PITCH_DECK_BUCKET="pitch-decks"

# Only used if STORAGE_PROVIDER=s3 (kept for non-Supabase environments):
AWS_S3_BUCKET=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# "enabled" makes POST /api/team/submission best-effort verify the GitHub
# repo actually exists via the public GitHub API. Leave unset/"disabled"
# for local dev — repo URL *format* is always validated either way.
GITHUB_API_VERIFICATION="disabled"
